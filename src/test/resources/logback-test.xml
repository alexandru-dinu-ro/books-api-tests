<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Console output: visible in IntelliJ and in the GitHub Actions log -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Log file: target/logs/test-run.log (can be uploaded as a CI artifact) -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>target/logs/test-run.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Keep the embedded web server quiet -->
    <logger name="org.eclipse.jetty" level="WARN"/>
    <logger name="io.javalin" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
